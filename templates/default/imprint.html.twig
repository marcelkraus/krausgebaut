{% extends 'base.html.twig' %}

{% block title %}Impressum · krausgebaut von Marcel Kraus{% endblock %}
{% block meta_description %}Impressum von krausgebaut von Marcel Kraus. krausgebaut bietet Internet- und IT-Dienstleistungen im Rhein-Erft-Kreis (bei Köln).{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex,follow">{% endblock %}

{% block content %}
    <article class="mx-auto max-w-3xl px-6 pt-36 pb-24 lg:px-8 lg:pt-44 lg:pb-32">
        {{ include('partials/_eyebrow.html.twig', { text: 'Rechtliches' }) }}
        <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">Impressum</h1>

        <div class="mt-12 space-y-12">
            <section>
                <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">Angaben gemäß § 5 DDG</h2>
                <div class="mt-4 space-y-1 text-neutral-800">
                    <p class="font-display text-lg font-bold text-neutral-900">krausgebaut von Marcel Kraus</p>
                    <p>Internet- und IT-Dienstleistungen</p>
                    <p>Bonner Straße 88</p>
                    <p>50374 Erftstadt</p>
                    <p>Deutschland</p>
                </div>
            </section>

            <section>
                <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">Kontakt</h2>
                <dl class="mt-4 space-y-2 text-neutral-800">
                    <div class="flex gap-3"><dt class="w-24 shrink-0 text-neutral-500">E-Mail</dt><dd>mail(at)krausgebaut(dot)de</dd></div>
                    <div class="flex gap-3"><dt class="w-24 shrink-0 text-neutral-500">Telefon</dt><dd>Erstkontakt bitte per <a href="{{ path('app_homepage') }}#kontakt" class="hover:text-accent">Kontaktformular</a> oder per E-Mail</dd></div>
                </dl>
            </section>

            <section>
                <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">Umsatzsteuer</h2>
                <p class="mt-4 text-neutral-800">Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br><span class="font-mono">DE225346678</span></p>
            </section>

            <section>
                <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">Redaktionell verantwortlich</h2>
                <p class="mt-4 text-neutral-800">Marcel Kraus, Anschrift wie oben.</p>
            </section>

            <section>
                <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-neutral-500">Verbraucherstreitbeilegung</h2>
                <p class="mt-4 leading-relaxed text-neutral-700">Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
            </section>
        </div>
    </article>
{% endblock %}
