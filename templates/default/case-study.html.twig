{% extends 'base.html.twig' %}
{% import 'partials/_icons.html.twig' as icons %}

{% block title %}{{ reference.title }} · krausgebaut von Marcel Kraus{% endblock %}
{% block meta_description %}{{ reference.summary }}{% endblock %}

{% block content %}
    <article class="mx-auto max-w-3xl px-6 pt-32 pb-24 lg:px-8 lg:pt-40">
        <a href="{{ path('app_homepage') }}#referenzen" class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-neutral-500 transition-colors hover:text-accent-on-light">
            <span class="transition-transform group-hover:-translate-x-1">{{ icons.icon('arrow', 'h-4 w-4 rotate-180') }}</span>
            Referenzen
        </a>

        <header class="mt-8">
            <p class="flex flex-wrap items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-accent-on-light">
                <span class="inline-block h-2 w-2 shrink-0 rounded-[2px] bg-accent"></span>{{ reference.kategorie }}
                <span class="text-neutral-600">· {{ reference.kunde }}</span>
            </p>
            <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">{{ reference.title }}</h1>
            <p class="mt-5 text-lg leading-relaxed text-neutral-600">{{ reference.summary }}</p>
        </header>

        {# Meta readout: role, stack, live link. #}
        <dl class="mt-10 grid gap-6 sm:grid-cols-2">
            {% if reference.rolle is defined and reference.rolle %}
                <div class="rounded-xl border border-neutral-200 bg-white p-6">
                    <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-neutral-500">Meine Rolle</dt>
                    <dd class="mt-2 text-sm leading-relaxed text-neutral-800">{{ reference.rolle }}</dd>
                </div>
            {% endif %}
            {% if reference.stack is defined and reference.stack %}
                <div class="rounded-xl border border-neutral-200 bg-white p-6">
                    <dt class="font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-neutral-500">Technologie</dt>
                    <dd class="mt-2 flex flex-wrap gap-2">
                        {% for tag in reference.stack %}
                            <span class="rounded-md bg-neutral-100 px-2.5 py-1 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-neutral-600">{{ tag }}</span>
                        {% endfor %}
                    </dd>
                </div>
            {% endif %}
        </dl>

        {% if reference.url is defined and reference.url %}
            <a href="{{ reference.url }}" target="_blank" rel="noopener" class="{{ include('partials/_button_class.html.twig', { size: 'compact' }, with_context = false) }} group mt-6">
                Projekt besuchen
                <span class="transition-transform group-hover:translate-x-1">{{ icons.icon('external', 'h-4 w-4') }}</span>
            </a>
        {% endif %}

        {# Case-study body: challenge → solution → result. #}
        <div class="mt-16 space-y-12">
            {% set chapters = [
                { label: 'Ausgangslage', body: reference.ausgangslage ?? null },
                { label: 'Lösung', body: reference.loesung ?? null },
                { label: 'Ergebnis', body: reference.ergebnis ?? null }
            ] %}
            {% for chapter in chapters %}
                {% if chapter.body %}
                    <section>
                        {{ include('partials/_eyebrow.html.twig', { text: chapter.label, heading: 'h2' }) }}
                        <p class="mt-4 text-base leading-relaxed text-neutral-700">{{ chapter.body }}</p>
                    </section>
                {% endif %}
            {% endfor %}
        </div>

        {# CTA #}
        <div class="mt-16 flex flex-col gap-4 rounded-xl border border-neutral-200 bg-neutral-50 p-8 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="font-display text-xl font-bold text-neutral-900">Sie haben etwas Ähnliches im Kopf?</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-neutral-600">Dann erzählen Sie mir davon. Ich bin gespannt.</p>
            </div>
            <a href="{{ path('app_homepage') }}#kontakt" class="{{ include('partials/_button_class.html.twig', {}, with_context = false) }} shrink-0">Projekt anfragen</a>
        </div>
    </article>
{% endblock %}
