{# Small accent pill that sits next to a title – marks a focus service, the
   state a reference is in, or the set-apart freelancing offering.
   Expects: text. #}
<span class="inline-flex items-center rounded-md bg-accent/10 px-2.5 py-1 font-mono text-[0.625rem] font-semibold uppercase tracking-[0.15em] text-accent-on-light">{{ text }}</span>
