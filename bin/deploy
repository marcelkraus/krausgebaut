#!/usr/bin/env bash
#
# Rolls the checked-out branch out. Run it on the server, inside the
# application directory.
#
# `set -e` matters here: without it a failed `composer install` would be
# followed by a cache rebuild against half-installed dependencies, and the
# site would come back up broken instead of staying on the old release.
set -euo pipefail

# Everything the release needs from `.env.local` is checked before anything on
# disk moves. A refusal then leaves the site exactly as it was; the same check
# after the reset would leave new code standing against old dependencies and an
# old container.
if [ ! -f .env.local ]; then
    echo "bin/deploy: .env.local is missing – aborting." >&2
    exit 1
fi

# The secret keys CSRF and the anti-spam timestamp of the contact form, and the
# repository carries one for development. A missing or copied value therefore
# does not break the site – it silently ships a secret anybody can read, which
# makes both tokens forgeable. Invisible from the outside, so it is checked on
# every release.
if ! grep -qE '^APP_SECRET=.+' .env.local || grep -qE '^APP_SECRET=(<ChangeMe|""$)' .env.local; then
    echo "bin/deploy: .env.local has no usable APP_SECRET – aborting." >&2
    exit 1
fi

# The check above only proves the line is not empty, so a `.env.local` that
# copied the committed value would pass it. That is the exact case the
# paragraph above describes, and describing it is not the same as excluding it.
committed_secret=$(grep -E '^APP_SECRET=' .env | cut -d= -f2-)
if [ -n "$committed_secret" ] && grep -qF "APP_SECRET=${committed_secret}" .env.local; then
    echo "bin/deploy: .env.local repeats the APP_SECRET from the repository – aborting." >&2
    exit 1
fi

# Whether a message from the contact form reaches anyone fails silently: the
# form answers with its confirmation page either way, so a mailbox nobody reads
# looks exactly like a mailbox that works.
#
# `MAILER_DSN` is the one setting that has to be overridden here, because the
# committed value is `null://null` and throws every mail away without an error.
if ! grep -qE '^MAILER_DSN=.+' .env.local || grep -qE '^MAILER_DSN=null://' .env.local; then
    echo "bin/deploy: .env.local sets no usable MAILER_DSN – aborting." >&2
    exit 1
fi

# The contact addresses may come from either file. `.env` ships the real ones,
# so a project that does not override them is correctly configured – what is
# checked is the value that takes effect, not the file it comes from.
for setting in CONTACT_TO CONTACT_FROM; do
    if [ -z "$(grep -hE "^${setting}=.+" .env.local .env 2>/dev/null | head -1 | cut -d= -f2-)" ]; then
        echo "bin/deploy: neither .env.local nor .env sets ${setting} – aborting." >&2
        exit 1
    fi
done

# `.env` carries APP_ENV=dev for development. Without an override the
# auto-scripts of `composer install` build the cache for the wrong environment.
if ! grep -qE '^APP_ENV=prod$' .env.local; then
    echo "bin/deploy: .env.local does not set APP_ENV=prod – aborting." >&2
    exit 1
fi

git fetch --all
git reset --hard origin/main

composer install --no-dev --optimize-autoloader

# The compiled container is moved aside rather than cleared. `cache:clear`
# loads the existing container before it replaces it, so a release that drops
# a bundle makes it die on a class that no longer exists – reproduced once,
# and it takes the site down for the length of the fix.
#
# Moved rather than deleted outright, because a plain `rm -rf` races the web
# server: PHP-FPM writes into the directory while rm walks it and rm gives up
# with "Directory not empty". Under `set -e` that aborts the deployment right
# between removing the cache and rebuilding it, which is the worst possible
# moment. The rename is atomic and cannot race; sweeping the leftovers
# afterwards may fail harmlessly, so it is allowed to.
if [ -d var/cache/prod ]; then
    discard="var/cache/prod.discard.$$"
    mv var/cache/prod "$discard"
    rm -rf "$discard" || true
fi

bin/console cache:clear --env=prod --no-debug
