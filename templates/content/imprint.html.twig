{% extends 'base.html.twig' %}

{% block title %}Impressum · krausgebaut von Marcel Kraus{% endblock %}
{% block meta_description %}Impressum von krausgebaut von Marcel Kraus. krausgebaut bietet Internet- &amp; IT-Dienstleistungen im Rhein-Erft-Kreis (bei Köln).{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex,follow">{% endblock %}

{% block content %}
    <article class="mx-auto max-w-3xl px-6 pt-36 pb-16 lg:px-8 lg:pt-40 lg:pb-20">
        {{ include('partials/_eyebrow.html.twig', { text: 'Rechtliches' }) }}
        <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">Impressum</h1>
        <p class="mt-4 font-mono text-xs uppercase tracking-[0.15em] text-neutral-500">Stand: 11. August 2026</p>

        <div class="mt-12 space-y-12">
            <section>
                <h2 class="font-display text-xl font-bold text-neutral-900">Angaben gemäß § 5 DDG</h2>
                <div class="mt-4 space-y-1 text-neutral-800">
                    <p class="font-display text-lg font-bold text-neutral-900">krausgebaut von Marcel Kraus</p>
                    <p>Marcel Kraus</p>
                    <p>Bonner Straße 88</p>
                    <p>50374 Erftstadt</p>
                    <p>Deutschland</p>
                </div>
            </section>

            <section>
                <h2 class="font-display text-xl font-bold text-neutral-900">Kontakt</h2>
                <dl class="mt-4 space-y-2 text-neutral-800">
                    <div class="flex gap-3"><dt class="w-24 shrink-0 text-neutral-500">E-Mail</dt><dd>{{ include('partials/_legal_mail_address.html.twig') }}</dd></div>
                    <div class="flex gap-3"><dt class="w-24 shrink-0 text-neutral-500">WhatsApp</dt><dd><a href="{{ path('app_contact_whats_app') }}" class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover">Über den WhatsApp-Link auf dieser Seite</a></dd></div>
                    <div class="flex gap-3"><dt class="w-24 shrink-0 text-neutral-500">Telefon</dt><dd>Erstkontakt bitte per <a href="{{ path('app_homepage') }}#kontakt" class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover">Kontaktformular</a>, per E-Mail oder per WhatsApp</dd></div>
                </dl>
            </section>

            <section>
                <h2 class="font-display text-xl font-bold text-neutral-900">Umsatzsteuer</h2>
                <p class="mt-4 text-neutral-800">Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br><span class="font-mono">DE225346678</span></p>
            </section>

            <section>
                <h2 class="font-display text-xl font-bold text-neutral-900">Redaktionell verantwortlich</h2>
                <p class="mt-4 text-neutral-800">Marcel Kraus, Anschrift wie oben.</p>
            </section>

            <section>
                <h2 class="font-display text-xl font-bold text-neutral-900">Verbraucherstreitbeilegung</h2>
                <p class="mt-4 leading-relaxed text-neutral-700">Ich bin nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.</p>
            </section>
        </div>
    </article>
{% endblock %}
