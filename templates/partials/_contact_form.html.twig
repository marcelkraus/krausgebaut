{# Hand-rolled contact form. Expects: errors (map path→message),
   old (submitted values), ts + ts_sig (signed anti-spam timestamp). #}
{% import _self as field %}

{% macro label(name, text, required) %}
    <label for="f_{{ name }}" class="block font-mono text-xs uppercase tracking-[0.15em] text-neutral-600">{{ text }}{% if required %} <span class="text-accent-on-light" aria-hidden="true">*</span>{% endif %}</label>
{% endmacro %}

{% macro input(name, text, old, errors, options) %}
    {% set options = options|default({}) %}
    {% set error = errors[name]|default(null) %}
    {% set required = options.required|default(false) %}
    <div>
        {{ _self.label(name, text, required) }}
        <input type="{{ options.type|default('text') }}" id="f_{{ name }}" name="{{ name }}" value="{{ old[name]|default('') }}"
               {% if options.autocomplete is defined %}autocomplete="{{ options.autocomplete }}"{% endif %}
               {% if required %}aria-required="true"{% endif %}
               class="mt-2 w-full rounded-lg border {{ error ? 'border-error-border' : 'border-neutral-200' }} bg-white px-4 py-3 text-sm text-neutral-900 {{ error ? 'focus:border-error-border' : 'focus:border-accent' }} focus:outline-2 focus:outline-offset-2 focus:outline-accent"
               {% if error %}aria-invalid="true" aria-describedby="e_{{ name }}"{% endif %}>
        {% if error %}<p id="e_{{ name }}" class="mt-1.5 font-mono text-xs text-error">{{ error }}</p>{% endif %}
    </div>
{% endmacro %}

<form method="post" action="{{ path('app_contact') }}" class="space-y-5" novalidate{% if focus is defined and focus %} data-error-focus="{{ focus }}"{% endif %}>
    <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
    <input type="hidden" name="ts" value="{{ ts }}">
    <input type="hidden" name="ts_sig" value="{{ ts_sig }}">

    {# Honeypot: hidden from users, tempting to bots. A neutral field name
       that browser autofill is unlikely to populate for a real visitor. #}
    <div class="sr-only" aria-hidden="true">
        <label for="f_website">Dieses Feld bitte leer lassen</label>
        <input type="text" id="f_website" name="website" tabindex="-1" autocomplete="off">
    </div>

    {% if errors.form is defined %}
        <p class="rounded-lg border border-error-border bg-error-surface px-4 py-3 font-mono text-xs text-error-on-surface" role="alert">{{ errors.form }}</p>
    {% endif %}

    <div class="grid gap-5 sm:grid-cols-2">
        {{ field.input('company', 'Firma', old, errors, { autocomplete: 'organization' }) }}
        {{ field.input('name', 'Name', old, errors, { required: true, autocomplete: 'name' }) }}
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
        {{ field.input('email', 'E-Mail', old, errors, { required: true, type: 'email', autocomplete: 'email' }) }}
        {{ field.input('phone', 'Telefon', old, errors, { type: 'tel', autocomplete: 'tel' }) }}
    </div>

    <div>
        {{ field.label('message', 'Nachricht', true) }}
        <textarea id="f_message" name="message" rows="5" aria-required="true"
                  {% if errors.message is defined %}aria-invalid="true" aria-describedby="e_message"{% endif %}
                  class="mt-2 w-full rounded-lg border {{ errors.message is defined ? 'border-error-border' : 'border-neutral-200' }} bg-white px-4 py-3 text-sm text-neutral-900 placeholder:text-neutral-500 {{ errors.message is defined ? 'focus:border-error-border' : 'focus:border-accent' }} focus:outline-2 focus:outline-offset-2 focus:outline-accent" placeholder="Erzählen Sie mir kurz von Ihrer Idee oder Ihrem Vorhaben.">{{ old.message|default('') }}</textarea>
        {% if errors.message is defined %}<p id="e_message" class="mt-1.5 font-mono text-xs text-error">{{ errors.message }}</p>{% endif %}
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
        <button type="submit" class="{{ include('partials/_button_class.html.twig', {}, with_context = false) }}">Nachricht senden</button>
        <p class="font-mono text-xs text-neutral-600">Pflichtfelder <span class="text-accent-on-light">*</span></p>
    </div>

    <p class="text-sm leading-relaxed text-neutral-600">Mit dem Absenden stimmen Sie meiner <a class="font-semibold text-accent-on-light transition-colors hover:text-accent-on-light-hover" href="{{ path('app_data_privacy') }}">Datenschutzerklärung</a> zu.</p>
</form>
