{# Section eyebrow: mono label preceded by a small square marker.
   Params: text, tone ('light' default, 'dark' for a dark ground, or
   'krausgedruckt' for the sibling cross-promo, which keeps that brand's
   own colour).

   The tone is not decoration. The petrol measures 2.72:1 on a dark ground
   and misses AA there, so the dark tone carries the brighter step. The
   sibling's papaya has the mirror problem and needs no lift on dark. #}
{% set tone = tone|default('light') %}
{% if tone == 'krausgedruckt' %}
    <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] text-brand-krausgedruckt">
        <span class="inline-block h-2 w-2 shrink-0 rounded-[2px] bg-brand-krausgedruckt"></span>{{ text }}
    </p>
{% else %}
    <p class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.2em] {{ tone == 'dark' ? 'text-accent-on-dark' : 'text-accent-on-light' }}">
        <span class="inline-block h-2 w-2 shrink-0 rounded-[2px] {{ tone == 'dark' ? 'bg-accent-on-dark' : 'bg-accent' }}"></span>{{ text }}
    </p>
{% endif %}
